# DATABASE_URL: PostgreSQL connection string.
# In Docker Compose, this defaults to the linked 'db' container.
DATABASE_URL=postgresql://postgres:postgres@db:5432/haujee

# JWT_SECRET: Secret key for signing JSON Web Tokens.
JWT_SECRET=super-secret-key-change-me

# Local Storage (Files are saved to ./uploads/receipts and ./uploads/odf)
# No configuration needed, but ensure the folder is writable.

# Meta WhatsApp Cloud API (Optional for notifications)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=receipt_notification
WHATSAPP_ODF_TEMPLATE_NAME=odf_notification

# Brevo / Sendinblue (Email) (Optional for notifications)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME="Haujee Jewellery"

# TRUST_PROXY: number of reverse proxies in front of the app, so client IPs are
# read correctly (login rate limit, audit log). Cloudflare -> Traefik -> app = 2.
# Leave at 0 when the app is reached directly.
TRUST_PROXY=0

# APP_URL: Public base URL of the app. Required for WhatsApp: Meta downloads
# the receipt PDF from a signed link under this address.
APP_URL=http://localhost:3000
